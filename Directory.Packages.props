<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <NuGetAuditMode>direct</NuGetAuditMode>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="BenchmarkDotNet" Version="0.15.8"/>
        <PackageVersion Include="Bogus" Version="35.6.5"/>
        <PackageVersion Include="FakeItEasy" Version="9.0.1"/>
        <PackageVersion Include="FakeItEasy.Analyzer.CSharp" Version="6.1.1"/>
        <PackageVersion Include="FluentValidation" Version="12.2.0"/>
        <PackageVersion Include="Grpc.AspNetCore.Server" Version="2.84.0"/>
        <PackageVersion Include="Grpc.Net.Client" Version="2.84.0"/>
        <PackageVersion Include="Grpc.Net.Client.Web" Version="2.84.0"/>
        <PackageVersion Include="Grpc.Reflection" Version="2.84.0"/>
        <PackageVersion Include="MessagePack" Version="3.1.12"/>
        <PackageVersion Include="Microsoft.AspNetCore.JsonPatch.SystemTextJson" Version="10.0.13"/>
        <PackageVersion Include="Microsoft.AspNetCore.OData" Version="9.5.0"/>
        <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.2.0"/>
        <PackageVersion Include="NBomber" Version="6.7.0"/>
        <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0"/>
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="[5.0.0]"/><!-- .NET 10 SDK / Visual Studio 2026 18.0 is the minimum analyzer host -->
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13"/>
        <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13"/>
        <PackageVersion Include="Microsoft.Extensions.Primitives" Version="10.0.13"/>
        <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.402"/>
        <PackageVersion Include="protobuf-net" Version="3.4.30"/>
        <PackageVersion Include="RichardSzalay.MockHttp" Version="7.1.0"/>
        <PackageVersion Include="Scalar.AspNetCore" Version="2.18.0"/>
        <PackageVersion Include="Shouldly" Version="4.3.0"/>
        <PackageVersion Include="xunit.v3" Version="4.0.2"/>
        <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.2"/>
    </ItemGroup>
    <ItemGroup>
        <!-- Deprecate at a future FE major version jump -->
        <PackageVersion Include="NSwag.AspNetCore" Version="14.7.1"/>
        <PackageVersion Include="NSwag.Generation" Version="14.7.1"/>
        <PackageVersion Include="NSwag.Generation.AspNetCore" Version="14.7.1"/>
        <PackageVersion Include="NSwag.CodeGeneration.CSharp" Version="14.7.1"/>
        <PackageVersion Include="NSwag.CodeGeneration.TypeScript" Version="14.7.1"/>
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13"/>
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13"/>
        <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.13"/>
        <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13"/>
        <PackageVersion Include="Microsoft.OpenApi.Kiota.Builder" Version="[1.29.2]"/><!-- Keep Microsoft.OpenApi 2.x compatibility with ASP.NET Core OpenAPI 10. -->

        <!-- Asp.Versioning.OpenApi requires Microsoft.OpenApi < 3.0.0; the integration remains net10 only until its .net11 compatible -->
        <PackageVersion Include="Asp.Versioning.Http" Version="10.2.3"/>
        <PackageVersion Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.2.1"/>
        <PackageVersion Include="Asp.Versioning.OpenApi" Version="10.2.3"/>
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
        <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0-rc.2.26504.105"/>
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0-rc.2.26504.105"/>
        <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="11.0.0-rc.2.26504.105"/>
        <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0-rc.2.26504.105"/>
        <PackageVersion Include="Microsoft.OpenApi.Kiota.Builder" Version="1.36.1"/>
    </ItemGroup>
</Project>